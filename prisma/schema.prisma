// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============== USERS ==============
model User {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String    @unique
  passwordHash      String    @map("password_hash")
  avatarUrl         String?   @map("avatar_url")
  role              String    @default("user")
  emailVerified     Boolean   @default(false) @map("email_verified")
  usernameChangedAt DateTime? @map("username_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  novelList         UserNovelList[]
  tokens            Token[]
  activities        Activity[]
  favoriteAuthors   UserFavoriteAuthor[]

  @@map("users")
}

// ============== NOVELS ==============
model Novel {
  id             Int       @id @default(autoincrement())
  title          String
  titleChinese   String?   @map("title_chinese")
  author         String?
  description    String?   @db.Text
  coverImageUrl  String?   @map("cover_image_url")
  totalChapters  Int?      @map("total_chapters")
  status         String?
  genres         String[]
  tags           String[]
  originalSource String?   @map("original_source")
  yearPublished  Int?      @map("year_published")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  userEntries    UserNovelList[]

  @@map("novels")
}

// ============== USER'S NOVEL LIST ==============
model UserNovelList {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id")
  novelId        Int       @map("novel_id")
  status         String
  rating         Float?
  currentChapter Int       @default(0) @map("current_chapter")
  isFavorite     Boolean   @default(false) @map("is_favorite")
  dateStarted    DateTime? @map("date_started")
  dateFinished   DateTime? @map("date_finished")
  notes          String?   @db.Text
  readingUrl     String?   @map("reading_url")
  rereadCount    Int       @default(0) @map("reread_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel          Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@map("user_novel_list")
}

// ============== ACTIVITY LOG ==============
model Activity {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  type      String   // "add", "status_change", "chapter_update", "rating", "remove"
  novelId   Int?     @map("novel_id")
  detail    String?  // e.g., "Chapter 45 → 46", "Rated 8.5"
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activities")
}

model Token {
  id        String   @id @default(cuid())
  type      String   // "email_verification" or "password_reset"
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

model UserFavoriteAuthor {
  id         Int      @id @default(autoincrement())
  userId     String   @map("user_id")
  authorName String   @map("author_name")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, authorName])
  @@map("user_favorite_authors")
}