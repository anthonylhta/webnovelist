// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

// ============== USERS ==============
model User {
  id                String    @id @default(cuid())
  clerkId           String?   @unique @map("clerk_id")
  username          String    @unique
  email             String    @unique
  avatarUrl         String?   @map("avatar_url")
  bannerColor       String?   @map("banner_color")
  role              String    @default("user")
  usernameChangedAt DateTime? @map("username_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  novelList         UserNovelList[]
  activities        Activity[]
  favoriteAuthors   UserFavoriteAuthor[]
  submissions         NovelSubmission[] @relation("SubmittedBy")
  reviewedSubmissions NovelSubmission[] @relation("ReviewedBy")

  favoriteCharacters UserFavoriteCharacter[]
  following          Follow[] @relation("Follower")  // rows where this user follows someone
  followers          Follow[] @relation("Following") // rows where someone follows this user

  @@map("users")
}

// ============== FOLLOWS ==============
// One row per follower → following edge; the feed reads the activities of
// the readers a user follows.
model Follow {
  id          Int      @id @default(autoincrement())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("follows")
}

// ============== AUTHORS ==============
model Author {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  bio       String?  @db.Text
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  novels    Novel[]
  favorites UserFavoriteAuthor[]

  @@map("authors")
}

// ============== NOVELS ==============
model Novel {
  id             Int       @id @default(autoincrement())
  title          String
  nativeTitle    String?   @map("native_title")
  altTitles      String[]  @default([]) @map("alt_titles") // romaji, acronyms, other English renderings
  mediaType      String    @default("webnovel") @map("media_type")
  author         String?
  authorId       Int?      @map("author_id")
  description    String?   @db.Text
  coverImageUrl  String?   @map("cover_image_url")
  totalChapters  Int?      @map("total_chapters")
  latestChapter  Int?      @map("latest_chapter") // latest released chapter, for ongoing series
  status         String?
  genres         String[]
  tags           String[]
  originalSource String?   @map("original_source")
  yearPublished  Int?      @map("year_published")
  anilistId      Int?      @unique @map("anilist_id")
  malId          Int?      @unique @map("mal_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  authorEntity   Author?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  characters     Character[]
  userEntries    UserNovelList[]
  relationsFrom  NovelRelation[] @relation("RelationFrom")
  relationsTo    NovelRelation[] @relation("RelationTo")
  submissions    NovelSubmission[]

  // Trigram indexes back both ILIKE '%q%' and the % similarity operator (see lib/search.ts).
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "novels_title_trgm_idx")
  @@index([nativeTitle(ops: raw("gin_trgm_ops"))], type: Gin, map: "novels_native_title_trgm_idx")
  @@index([author(ops: raw("gin_trgm_ops"))], type: Gin, map: "novels_author_trgm_idx")
  @@map("novels")
}

// ============== NOVEL RELATIONS ==============
// One row per link, read from `from`'s side: `to` is the `kind` of `from`
// (e.g. kind "adaptation" — the manhwa is an adaptation of the webnovel).
// The other direction is derived via the inverse kind (lib/relations.ts).
model NovelRelation {
  id        Int      @id @default(autoincrement())
  fromId    Int      @map("from_id")
  toId      Int      @map("to_id")
  kind      String   // see RELATION_KINDS in lib/relations.ts
  createdAt DateTime @default(now()) @map("created_at")

  from      Novel    @relation("RelationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        Novel    @relation("RelationTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind])
  @@index([toId])
  @@map("novel_relations")
}

// ============== TITLE SUBMISSIONS ==============
// Readers propose titles that aren't in the catalog; mods approve (creating a
// Novel), merge into an existing Novel, or reject. Kept apart from Novel so the
// catalog never carries unreviewed rows.
model NovelSubmission {
  id           Int       @id @default(autoincrement())
  userId       String    @map("user_id")
  title        String
  nativeTitle  String?   @map("native_title")
  mediaType    String    @default("webnovel") @map("media_type")
  author       String?
  sourceUrl    String?   @map("source_url")   // where it can be read / verified
  description  String?   @db.Text
  note         String?   @db.Text             // submitter's note to the mods
  status       String    @default("pending")  // pending | approved | merged | rejected
  novelId      Int?      @map("novel_id")     // the catalog title it became or was merged into
  reviewNote   String?   @map("review_note") @db.Text
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User      @relation("SubmittedBy", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?     @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  novel        Novel?    @relation(fields: [novelId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@map("novel_submissions")
}

// ============== USER'S NOVEL LIST ==============
model UserNovelList {
  id             Int       @id @default(autoincrement())
  userId         String    @map("user_id")
  novelId        Int       @map("novel_id")
  status         String
  rating         Float?
  currentChapter Int       @default(0) @map("current_chapter")
  isFavorite     Boolean   @default(false) @map("is_favorite")
  dateStarted    DateTime? @map("date_started")
  dateFinished   DateTime? @map("date_finished")
  notes          String?   @db.Text
  readingUrl     String?   @map("reading_url")
  rereadCount    Int       @default(0) @map("reread_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel          Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@map("user_novel_list")
}

// ============== ACTIVITY LOG ==============
model Activity {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  type      String   // "add", "status_change", "chapter_update", "rating", "remove"
  novelId   Int?     @map("novel_id")
  detail    String?  // e.g., "Chapter 45 → 46", "Rated 8.5"
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activities")
}

model UserFavoriteAuthor {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  authorId  Int      @map("author_id")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([userId, authorId])
  @@map("user_favorite_authors")
}

model Character {
  id        Int      @id @default(autoincrement())
  name      String
  role      String?  // "Protagonist", "Main Character", "Antagonist", "Supporting"
  novelId   Int      @map("novel_id")
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  favorites UserFavoriteCharacter[]

  @@unique([name, novelId])
  @@map("characters")
}

model UserFavoriteCharacter {
  id          Int      @id @default(autoincrement())
  userId      String   @map("user_id")
  characterId Int      @map("character_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([userId, characterId])
  @@map("user_favorite_characters")
}