{
  "name": "webnovelist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prod:migrate": "dotenv -e .env.prod -- npx prisma migrate deploy",
    "prod:studio": "dotenv -e .env.prod -- npx prisma studio",
    "prod:seed": "dotenv -e .env.prod -- npx prisma db seed",
    "prod:export": "dotenv -e .env.prod -- npx tsx scripts/export-novels.ts",
    "dev:import": "npx tsx scripts/import-novels.ts",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "npx tsx --tsconfig tsconfig.json prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.3",
    "@prisma/client": "^6.19.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.27.0",
    "next": "^16.3.0",
    "prisma": "^6.19.3",
    "rate-limiter-flexible": "^11.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.24",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^7",
    "vitest": "^4.1.10"
  }
}
